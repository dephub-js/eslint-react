{
  "name": "@dephub/eslint-react",
  "type": "module",
  "version": "1.0.5",
  "description": "Opinionated modern ESLint configuration for React projects.",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "scripts": {
    "prepublishOnly": "pnpm clean && pnpm check && pnpm build && pnpm lint",
    "release": "pnpm publish",
    "docs": "lineo md 'src/**/*.ts' --outFile code.md --outDir temp",
    "check": "tsc --noEmit",
    "test": "tsx --test src",
    "lint": "eslint . --fix --max-warnings 0",
    "fmt": "prettier --write .",
    "clean": "rm -rf dist",
    "build": "vite build",
    "dev": "vite build -w"
  },
  "keywords": [
    "eslint-react",
    "lint",
    "eslint",
    "eslint-config",
    "react",
    "typescript",
    "ts",
    "config",
    "preset",
    "linter",
    "code-quality"
  ],
  "author": {
    "name": "Estarlin R",
    "email": "dev@estarlincito.com",
    "url": "https://estarlincito.com"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "license": "MIT",
  "homepage": "https://github.com/dephub-js/eslint-react#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/dephub-js/eslint-react.git"
  },
  "bugs": {
    "url": "https://github.com/dephub-js/eslint-react/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.30.3",
  "dependencies": {
    "@dephub/eslint-ts": "^1.0.5",
    "@types/eslint": "^9.6.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@dephub/glob": "^1.0.2",
    "@dephub/path": "^1.0.2",
    "@types/node": "^26.6.6",
    "prettier": "^3.9.10",
    "typescript": "6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2"
  }
}